<div class="min-w-0 max-w-2xl flex-auto px-4 py-16 lg:max-w-none lg:pl-8 lg:pr-0 xl:px-16">
  <.prose>
    <p class="font-display text-sm font-medium text-sky-500">
      <%= gettext("Start now!") %>
    </p>
    <h1>
      <%= gettext("Coming next: real time with LiveView") %>
    </h1>
    <p>
      <strong><%= gettext("Changelog:") %></strong>
    </p>
    <ul class="my-4 list-disc pl-6">
      <li><%= gettext("May 1st: Test track is now part of the CRUD guide") %></li>
      <li><%= gettext("May 1st: V2 is live!") %></li>
    </ul>
  </.prose>
  <div class="my-12 grid grid-cols-1 gap-6 sm:grid-cols-2">
    <.quick_link
      title={gettext("Fundamentals")}
      icon="hero-chevron-double-right-solid"
      icon_class="dark:bg-white"
      href={~p"/guides/v2-getting-started/#{@locale}"}
      description={
        gettext("Step-by-step guides to learn the fundamentals of LiveView Programming.")
      }
    />

    <.quick_link
      title={gettext("Your first CRUD")}
      icon="hero-magnifying-glass"
      icon_class="dark:bg-white"
      href={~p"/guides/v2-my-first-liveview-project/#{@locale}"}
      description={gettext("Lets build a queue ticket system!")}
    />

    <.quick_link
      title={gettext("Real time with LiveView")}
      icon="hero-building-office-2-solid"
      icon_class="dark:bg-white"
      under_construction
    />

    <.quick_link
      title={gettext("Adding authentication and authorization to projects")}
      icon="hero-globe-alt-solid"
      icon_class="dark:bg-white"
      under_construction
    />

    <.quick_link
      :if={false}
      title={gettext("Projects track")}
      icon="hero-building-office-2-solid"
      icon_class="dark:bg-white"
      under_construction
    />

    <.quick_link
      :if={false}
      title={gettext("Deployments track")}
      icon="hero-globe-alt-solid"
      icon_class="dark:bg-white"
      under_construction
    />
  </div>
</div>
